# Maintainer: Anthony Schuler <anthonyschuler45 at gmail dot com>
pkgname=arch-housekeeper
pkgver=1.1
pkgrel=1
pkgdesc="Qt tool to remove applications and orphans and clean the pacman cache"
arch=('x86_64' 'aarch64')
url="https://github.com/Anthony-S45/Arch-Housekeeper"
license=('GPL-3.0-only')
depends=('qt6-base' 'pacman-contrib' 'polkit' 'diffutils' 'gcc-libs' 'glibc')
makedepends=('cmake' 'git')
optdepends=('xdg-user-dirs: find a localized Desktop folder for exports')
source=("$pkgname::git+$url.git#tag=v$pkgver")
sha256sums=('SKIP')

build() {
  cmake -B build -S "$pkgname" \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -Wno-dev
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
