# Builds Arch Housekeeper from the source folder one level up.
# Usage:  cd packaging && makepkg -si
pkgname=arch-housekeeper
pkgver=1.1
pkgrel=1
pkgdesc="Qt tool to remove applications and orphans and clean the pacman cache"
arch=('x86_64' 'aarch64')
license=('GPL-3.0-only')
depends=('qt6-base' 'pacman-contrib' 'polkit' 'diffutils' 'gcc-libs' 'glibc')
optdepends=('xdg-user-dirs: find a localized Desktop folder for exports')
makedepends=('cmake')

build() {
  cmake -B build -S "$startdir/.." \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
